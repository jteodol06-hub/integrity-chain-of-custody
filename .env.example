# ==============================================================================
# INTEGRITY & CHAIN-OF-CUSTODY FOCUSED (ICCF) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# Client URL (for CORS restriction)
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL with Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iccf_db?schema=public"

# Authentication & Session Security
# Generate a secure random string (minimum 32 characters) in production
JWT_SECRET="iccf_development_secure_jwt_secret_key_minimum_32_chars"
JWT_EXPIRES_IN="8h"

# Evidence Storage Configuration (Defensive & Isolated Private Directory)
# Files are stored outside publicly served directories with randomized identifiers
EVIDENCE_STORAGE_PATH="./storage/evidence"
MAX_FILE_SIZE_BYTES=52428800 # 50 MB

# Security Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=200
